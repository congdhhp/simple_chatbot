# Simple LLM Service Configuration

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=1
LOG_LEVEL=INFO

# Authentication
JWT_SECRET_KEY=your-secret-key-change-in-production-must-be-very-long-and-random
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Model Configuration
DEFAULT_MODEL=llama-3.2-3b-instruct
MODEL_CACHE_DIR=/home/appuser/.cache/huggingface
ENABLE_FLASH_ATTENTION=true

# CUDA Configuration
CUDA_VISIBLE_DEVICES=0
TOKENIZERS_PARALLELISM=false

# Rate Limiting
ENABLE_RATE_LIMITING=true
REDIS_URL=redis://redis:6379/0

# Monitoring
ENABLE_METRICS=true
METRICS_RETENTION_HOURS=24

# Security
ENABLE_AUTHENTICATION=true
REQUIRE_AUTH_FOR_COMPLETIONS=true

# Performance
MAX_CONCURRENT_REQUESTS=10
REQUEST_TIMEOUT_SECONDS=300
MODEL_LOAD_TIMEOUT_SECONDS=600

# Storage
CONVERSATIONS_DIR=./conversations
LOGS_DIR=./logs
