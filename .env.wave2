# Wave 2 Environment Configuration

# Model Registry Settings
MAX_MODELS=3
MEMORY_BUDGET_GB=14.0
PRELOAD_ALL_MODELS=false

# Safety Pipeline Settings  
SAFETY_LEVEL=moderate
ENABLE_PII_DETECTION=true

# Logging Settings
JSON_LOGS=false
LOG_LEVEL=INFO

# Rate Limiting Settings
ENABLE_TOKEN_RATE_LIMITING=true

# SSE Settings
SSE_HEARTBEAT_INTERVAL=5

# Cost Estimation (optional)
COST_PER_1K_PROMPT_TOKENS=0.0015
COST_PER_1K_COMPLETION_TOKENS=0.002

# JWT Settings
JWT_SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
